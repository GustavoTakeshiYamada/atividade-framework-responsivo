<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atividade - Framework Responsivo (Tailwind CSS)</title>
  <!-- Framework Responsivo: Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 flex flex-col min-h-screen">

  <!-- 1. BARRA DE MENU (RESPONSIVA) -->
  <nav class="bg-blue-600 text-white p-4 shadow-md">
    <div class="container mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">MeuProjeto</h1>
      
      <!-- Menu Desktop -->
      <ul class="hidden md:flex space-x-6">
        <li><a href="#tabela" class="hover:underline">Tabela</a></li>
        <li><a href="#galeria" class="hover:underline">Galeria</a></li>
        <li><a href="#formulario" class="hover:underline">Contato</a></li>
      </ul>

      <!-- Botão Menu Mobile -->
      <button id="btn-menu-mobile" class="md:hidden focus:outline-none text-2xl">
        &#9776;
      </button>
    </div>

    <!-- Dropdown Mobile -->
    <div id="menu-mobile" class="hidden md:hidden mt-3 space-y-2 pb-2">
      <a href="#tabela" class="block hover:bg-blue-700 p-2 rounded">Tabela</a>
      <a href="#galeria" class="block hover:bg-blue-700 p-2 rounded">Galeria</a>
      <a href="#formulario" class="block hover:bg-blue-700 p-2 rounded">Contato</a>
    </div>
  </nav>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="container mx-auto p-4 md:p-8 flex-grow space-y-12">

    <!-- 2. TABELA RESPONSIVA -->
    <section id="tabela" class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4 text-blue-600">Tabela de Alunos / Cadastros</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-blue-50 border-b border-gray-200 text-gray-700">
              <th class="p-3">ID</th>
              <th class="p-3">Nome</th>
              <th class="p-3">Curso</th>
              <th class="p-3">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100 hover:bg-gray-50">
              <td class="p-3">01</td>
              <td class="p-3 font-medium">Ana Silva</td>
              <td class="p-3">Desenvolvimento Web</td>
              <td class="p-3"><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-semibold">Ativo</span></td>
            </tr>
            <tr class="border-b border-gray-100 hover:bg-gray-50">
              <td class="p-3">02</td>
              <td class="p-3 font-medium">Carlos Eduardo</td>
              <td class="p-3">Sistemas de Informação</td>
              <td class="p-3"><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-semibold">Ativo</span></td>
            </tr>
            <tr class="border-b border-gray-100 hover:bg-gray-50">
              <td class="p-3">03</td>
              <td class="p-3 font-medium">Mariana Costa</td>
              <td class="p-3">Design Gráfico</td>
              <td class="p-3"><span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-semibold">Inativo</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. GALERIA DE IMAGENS -->
    <section id="galeria" class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4 text-blue-600">Galeria de Imagens</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <img src="https://picsum.photos/400/300?random=1" alt="Exemplo 1" class="w-full h-48 object-cover rounded shadow hover:opacity-90 transition">
        <img src="https://picsum.photos/400/300?random=2" alt="Exemplo 2" class="w-full h-48 object-cover rounded shadow hover:opacity-90 transition">
        <img src="https://picsum.photos/400/300?random=3" alt="Exemplo 3" class="w-full h-48 object-cover rounded shadow hover:opacity-90 transition">
      </div>
    </section>

    <!-- 4. FORMULÁRIO E BOTAO DO MODAL -->
    <section id="formulario" class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4 text-blue-600">Formulário de Contato</h2>
      <form id="form-exemplo" class="space-y-4 max-w-lg">
        <div>
          <label class="block font-medium text-gray-700 mb-1">Nome Completo</label>
          <input type="text" placeholder="Digite seu nome" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
        <div>
          <label class="block font-medium text-gray-700 mb-1">E-mail</label>
          <input type="email" placeholder="seu@email.com" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
        <div>
          <label class="block font-medium text-gray-700 mb-1">Mensagem</label>
          <textarea rows="3" placeholder="Escreva sua mensagem..." required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
        </div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
          Enviar Mensagem
        </button>
      </form>

      <!-- 5. BOTAO PARA ABRIR O MODAL -->
      <div class="mt-8 pt-6 border-t border-gray-200">
        <p class="mb-2 text-gray-600 font-medium">Exemplo de Modal em ação:</p>
        <button id="btn-abrir-modal" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition">
          Abrir Modal Informativo
        </button>
      </div>
    </section>

  </main>

  <!-- MODAL (INICIALMENTE OCULTO) -->
  <div id="modal-container" class="fixed inset-0 bg-black bg-opacity-50 hidden flex justify-center items-center p-4">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full">
      <h3 class="text-xl font-bold text-gray-800 mb-2">Aviso Importante</h3>
      <p class="text-gray-600 mb-6">Este é um exemplo de Janela Modal criada utilizando classes do Tailwind CSS e controlada por JavaScript.</p>
      <div class="flex justify-end">
        <button id="btn-fechar-modal" class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600 transition">
          Fechar
        </button>
      </div>
    </div>
  </div>

  <footer class="bg-gray-800 text-white text-center p-4 text-sm mt-8">
    Exemplo Prático - Tailwind CSS
  </footer>

  <!-- Script JS do projeto -->
  <script src="script.js"></script>
</body>
</html>
